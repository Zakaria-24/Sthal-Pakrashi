
MONGODB_URI="mongodb+srv://<db-user>:<db-password>@<cluster-host>"
MONGODB_DB_NAME="sthal_pakrashi_cms"

# Optional explicit DNS resolver override for Atlas SRV lookups.
# MONGODB_DNS_SERVERS="1.1.1.1,8.8.8.8"

JWT_SECRET="<generate-a-long-random-secret>"

# The one account with full control — the only one that can create staff users
# or change their passwords. Create it and set its password from the terminal
# with `npm run bootstrap:super-admin`; it can also sign in with a one-time code
# emailed to this address.
SUPER_ADMIN_EMAIL="admin@sthalpakrashi-institution.example"
SUPER_ADMIN_NAME="Sthal Pakrashi Admin"

OTP_EXPIRES_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_SECONDS="60"

# Delivery for login codes. Leave SMTP_HOST/USER/PASS blank and codes print to
# the dev server terminal instead. For Gmail, SMTP_PASS is an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SESSION_MAX_AGE_DAYS="7"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sthal-pakrashi"

# The public website's origin (it runs on 3004), not the dashboard's own.
ALLOWED_ORIGINS="http://localhost:3004"

# The public site caches content; after each save the Dashboard asks it to
# refresh. Same random value as the public site's REVALIDATE_SECRET
# (e.g. `openssl rand -hex 32`). PUBLIC_SITE_URL defaults to ALLOWED_ORIGINS[0].
PUBLIC_SITE_URL=""
REVALIDATE_SECRET=""
