# ==========================================================================
# Public website — environment template
# Copy to `.env.local`. No database or secret credentials live here: this
# project only reads content from the Dashboard's API.
# ==========================================================================

# Where the Sthal Pakrashi Dashboard (CMS + API) is running — NOT the main
# Uddom system's Dashboard (port 3000).
API_BASE_URL="http://localhost:3003"

# How long to wait for the CMS before showing bundled fallback content (ms).
API_TIMEOUT_MS="5000"

# CMS content is cached and refreshed in the background at most this often
# (seconds), so pages don't wait on the Dashboard API.
CMS_REVALIDATE_SECONDS="300"

# Lets the Dashboard refresh that cache right after a save (POST
# /api/revalidate). Same value as the Dashboard's REVALIDATE_SECRET.
REVALIDATE_SECRET=""
